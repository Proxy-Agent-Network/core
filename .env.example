# ==============================================================================
# Proxy Agent Network (PAN) — Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in your values.
#
# Naming convention: variables are grouped by subsystem. Required vs optional
# is called out inline. Values marked "FATAL if missing in prod" will cause
# hard startup failures when ENVIRONMENT=production — that is intentional
# fail-closed behavior; do not remove those checks.
# ==============================================================================


# ------------------------------------------------------------------------------
# CORE RUNTIME
# ------------------------------------------------------------------------------

# Controls dev bypasses across the codebase. Set to "production" to enable
# fail-closed security checks. Any other value (or unset) enables dev mode
# including MockRedis, mocked TPM, and relaxed CORS.
ENVIRONMENT=development

# Required by Flask app.py for session signing. FATAL if missing in prod.
# Must NOT be the literal string "fallback_local_secret".
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# Required by core/db.py. FATAL if missing or contains "proxy_secure_password".
DATABASE_URL=postgresql://user:password@localhost:5432/pan_db

# CORS allow-list for the FastAPI gateway (main.py). Comma-separated.
# In dev, localhost variants are added automatically.
ALLOWED_ORIGINS=https://command.proxyagent.network


# ------------------------------------------------------------------------------
# AWS / S3 — PII and Evidence Storage
# ------------------------------------------------------------------------------

# Onboarding document bucket (veteran credentials, etc.).
# FATAL if missing in prod.
S3_PII_BUCKET_NAME=

# Evidence bucket for mission photos. If unset, agent_api.py falls back to
# S3_PII_BUCKET_NAME with a warning. Strongly recommended to set before
# Mesa Pilot scale-up — SB 1417 evidence retention differs from PII.
S3_EVIDENCE_BUCKET_NAME=

AWS_REGION=us-west-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=


# ------------------------------------------------------------------------------
# HARDWARE ATTESTATION (TPM / Secure Enclave)
# ------------------------------------------------------------------------------

# Seed for hardware attestation challenge generation.
HARDWARE_ATTESTATION_SEED=

# Android package name for Play Integrity verification in onboarding.
# FATAL if missing in prod. Dev fallback: "com.pan.tactical".
ANDROID_PACKAGE_NAME=com.pan.tactical


# ------------------------------------------------------------------------------
# LND / LIGHTNING NETWORK (L402 Settlement Engine)
# ------------------------------------------------------------------------------
# All four required for M2H payouts. lightning_engine.py will refuse to
# initialize if LND_GRPC_HOST, LND_TLS_CERT_PATH, or LND_MACAROON_PATH is
# missing. Safe to leave blank during local dev — payment rails will be
# disabled but the rest of the app still boots.

LND_GRPC_HOST=
LND_GRPC_PORT=10009
LND_TLS_CERT_PATH=
LND_MACAROON_PATH=
LND_NETWORK=mainnet


# ------------------------------------------------------------------------------
# FLEET OPERATOR AUTHENTICATION (V2X Ed25519 public keys)
# ------------------------------------------------------------------------------
# Hex-encoded Ed25519 public keys for each registered fleet partner.
# Used by webhook_auth.py::verify_v2x_signature. Missing keys cause that
# fleet's distress signals to be rejected (401).
#
# SECURITY: The RFC 8037 test vector
# "d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a"
# will trigger a FATAL startup error in production. Never ship that key.

PUBKEY_WAYMO_MESA_01=
PUBKEY_MAGNA_TEST_01=


# ------------------------------------------------------------------------------
# CARRIER WEBHOOK SECRETS (HMAC-SHA256)
# ------------------------------------------------------------------------------
# Shared secrets for logistics partner webhook verification. Missing secrets
# cause that carrier's webhooks to be rejected. Optional — leave unset if
# you aren't integrating with that carrier yet.
#
# SECURITY: Secrets that start with "whsec_" AND contain "master" will
# trigger a FATAL startup error in production.

WHSEC_DHL=
WHSEC_FEDEX=
WHSEC_UPS=


# ------------------------------------------------------------------------------
# CHECKR (Background Check Integration)
# ------------------------------------------------------------------------------
# Used by onboarding_api.py to invite new agents to a Checkr background
# check. Missing key: onboarding will log a warning and skip Checkr step.

CHECKR_TEST_SECRET_KEY=
CHECKR_WEBHOOK_SECRET=


# ------------------------------------------------------------------------------
# OPS HUB (Tactical Mission Control)
# ------------------------------------------------------------------------------
# Shared token for the WebSocket telemetry stream. FATAL if missing in prod.
# In dev, falls back to "dev-token-777" with a warning.

OPS_HUB_TOKEN=

# Admin panel password for app.py /admin route. FATAL if missing in prod.
ADMIN_SECRET_TOKEN=


# ==============================================================================
# LEGACY VARIABLES (scheduled for removal)
# ==============================================================================
# These belong to the deprecated AI chatbot / agency subsystem and will be
# removed as part of the Option B cleanup pass. Do not set in new deployments.
#
#   GOOGLE_API_KEY        — Gemini 2.5 Flash for agent_engine_v2.py
#   PROXY_API_SECRET      — v1 "Proxy Protocol" bearer token
#   PROXY_API_PUBLIC      — v1 "Proxy Protocol" bearer token
#   AGENT_DISPLAY_NAME    — v1 trading-bot chatbot identity
#   AGENT_OWNER_EMAIL     — v1 trading-bot chatbot identity
#   LN_NODE_URI           — superseded by LND_GRPC_HOST/PORT/CERT/MACAROON
#   WEBHOOK_SECRET        — superseded by per-service secrets above
# ==============================================================================
